<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1a1a2e">
    <meta name="description" content="Mobile MTSFX STRATEGY Indicator Dashboard">
    <title>MTSFX Strategy Indicator</title>
    <link rel="manifest" href="manifest.json">
    <link rel="icon" type="image/png" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192'><rect fill='%231a1a2e' width='192' height='192'/><text x='96' y='120' font-size='80' fill='%2300d4ff' text-anchor='middle' font-weight='bold'>📊</text></svg>">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 100%);
            color: #e0e0e0;
            min-height: 100vh;
            padding: 10px;
            overflow-x: hidden;
        }

        .container {
            max-width: 100%;
            margin: 0 auto;
        }

        .header {
            background: linear-gradient(135deg, #16213e 0%, #0f3460 100%);
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            border-left: 4px solid #00d4ff;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .header h1 {
            font-size: 24px;
            color: #00d4ff;
            margin-bottom: 5px;
        }

        .header p {
            font-size: 12px;
            color: #a0a0a0;
        }

        .license-container {
            background: #16213e;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            border: 1px solid #00d4ff;
        }

        .license-container h2 {
            color: #00d4ff;
            font-size: 16px;
            margin-bottom: 12px;
        }

        .license-input-group {
            display: flex;
            gap: 8px;
            margin-bottom: 10px;
        }

        .license-input-group input {
            flex: 1;
            padding: 10px;
            background: #0f1928;
            border: 1px solid #00d4ff;
            color: #e0e0e0;
            border-radius: 5px;
            font-size: 14px;
        }

        .license-input-group button {
            padding: 10px 20px;
            background: #00d4ff;
            color: #0f1928;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }

        .license-input-group button:hover {
            background: #00a8cc;
            transform: scale(1.05);
        }

        .license-status {
            padding: 10px;
            border-radius: 5px;
            font-size: 14px;
            text-align: center;
        }

        .license-status.active {
            background: rgba(0, 212, 255, 0.2);
            color: #00d4ff;
            border: 1px solid #00d4ff;
        }

        .license-status.inactive {
            background: rgba(255, 67, 67, 0.2);
            color: #ff4343;
            border: 1px solid #ff4343;
        }

        .hidden {
            display: none;
        }

        .content {
            display: none;
        }

        .content.active {
            display: block;
        }

        .pair-selector {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 15px;
        }

        .pair-btn {
            padding: 12px;
            background: #16213e;
            border: 2px solid #444;
            color: #e0e0e0;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
            font-size: 13px;
        }

        .pair-btn.active {
            background: #00d4ff;
            color: #0f1928;
            border-color: #00d4ff;
        }

        .pair-btn:hover {
            border-color: #00d4ff;
        }

        .chart-container {
            background: #16213e;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        #chart {
            width: 100%;
            height: 400px;
            margin-bottom: 15px;
        }

        .indicator-container {
            background: #0f1928;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 10px;
            border-left: 3px solid #00d4ff;
        }

        .indicator-label {
            font-size: 12px;
            color: #a0a0a0;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .indicator-value {
            font-size: 20px;
            font-weight: bold;
            color: #00d4ff;
            margin-top: 5px;
        }

        .signal-box {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 15px;
        }

        .signal {
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            font-weight: bold;
            font-size: 14px;
            border: 2px solid transparent;
        }

        .signal.buy {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
            border-color: #4caf50;
        }

        .signal.sell {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
            border-color: #f44336;
        }

        .signal.neutral {
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
            border-color: #ffc107;
        }

        .loading {
            text-align: center;
            padding: 20px;
            color: #00d4ff;
            font-size: 14px;
        }

        .error-message {
            background: rgba(255, 67, 67, 0.2);
            color: #ff4343;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 15px;
            border-left: 3px solid #ff4343;
            display: none;
        }

        .error-message.show {
            display: block;
        }

        .api-key-info {
            background: rgba(0, 212, 255, 0.1);
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 15px;
            font-size: 12px;
            color: #a0a0a0;
            border: 1px solid #00d4ff;
        }

        .api-key-info a {
            color: #00d4ff;
            text-decoration: none;
        }

        .api-key-section {
            background: #16213e;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        .api-key-section input {
            width: 100%;
            padding: 10px;
            background: #0f1928;
            border: 1px solid #00d4ff;
            color: #e0e0e0;
            border-radius: 5px;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .api-key-section button {
            width: 100%;
            padding: 10px;
            background: #00d4ff;
            color: #0f1928;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }

        .api-key-section button:hover {
            background: #00a8cc;
        }

        .refresh-btn {
            width: 100%;
            padding: 12px;
            background: #00d4ff;
            color: #0f1928;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
            margin-bottom: 15px;
        }

        .refresh-btn:hover {
            background: #00a8cc;
            transform: scale(1.02);
        }

        .refresh-btn:disabled {
            background: #666;
            cursor: not-allowed;
            transform: none;
        }

        @media (max-width: 480px) {
            body {
                padding: 5px;
            }

            .header h1 {
                font-size: 20px;
            }

            #chart {
                height: 300px;
            }

            .pair-selector {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>📊 Forex Stochastic Indicator</h1>
            <p>Real-time technical analysis dashboard</p>
        </div>

        <!-- License Section -->
        <div class="license-container" id="licenseSection">
            <h2>🔐 Activate License</h2>
            <div class="license-input-group">
                <input type="password" id="licenseKeyInput" placeholder="Enter your license key">
                <button onclick="activateLicense()">Activate</button>
            </div>
            <div class="license-status inactive" id="licenseStatus">❌ License Inactive</div>
        </div>

        <!-- Main Content (Hidden until license activated) -->
        <div id="mainContent" class="content">
            <!-- API Key Setup -->
            <div class="api-key-info">
                <strong>⚙️ Setup Required:</strong> Add your free API key from <a href="https://www.alphavantage.co" target="_blank">AlphaVantage.co</a> below to enable live data.
            </div>

            <div class="api-key-section">
                <input type="text" id="apiKeyInput" placeholder="Enter AlphaVantage API Key">
                <button onclick="saveApiKey()">Save API Key</button>
            </div>

            <!-- Error Message -->
            <div class="error-message" id="errorMessage"></div>

            <!-- Currency Pair Selector -->
            <div class="pair-selector">
                <button class="pair-btn active" onclick="selectPair('EUR/USD', 'EURUSD')">EUR/USD</button>
                <button class="pair-btn" onclick="selectPair('GBP/USD', 'GBPUSD')">GBP/USD</button>
                <button class="pair-btn" onclick="selectPair('XAU/USD', 'XAUUSD')">XAU/USD</button>
                <button class="pair-btn" onclick="selectPair('USD/JPY', 'USDJPY')">USD/JPY</button>
                <button class="pair-btn" onclick="selectPair('GBP/JPY', 'GBPJPY')">GBP/JPY</button>
                <button class="pair-btn" onclick="selectPair('US 30', 'US30')">US 30</button>
                <button class="pair-btn" onclick="selectPair('NAS 100', 'NAS100')">NAS 100</button>
                <button class="pair-btn" onclick="selectPair('US OIL', 'USOIL')">US OIL</button>
            </div>

            <!-- Chart Container -->
            <div class="chart-container">
                <canvas id="chart"></canvas>
                <div class="loading hidden" id="loading">Loading chart data...</div>
            </div>

            <!-- Stochastic Indicator -->
            <div class="indicator-container">
                <div class="indicator-label">Stochastic Oscillator</div>
                <div class="indicator-value" id="stochasticValue">K: -- | D: --</div>
            </div>

            <!-- Trading Signals -->
            <div class="signal-box">
                <div class="signal buy" id="buySignal">🟢 BUY<br><small id="buyReason">Awaiting data</small></div>
                <div class="signal sell" id="sellSignal">🔴 SELL<br><small id="sellReason">Awaiting data</small></div>
            </div>

            <!-- Refresh Button -->
            <button class="refresh-btn" onclick="refreshData()">🔄 Refresh Data</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="app.js"></script>
</body>
</html>
